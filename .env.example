# Postgres (Neon recommended — pair with Vercel hosting for the app itself)
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"

# NextAuth
NEXTAUTH_SECRET="generate-with-openssl-rand-base64-32"
NEXTAUTH_URL="http://localhost:3000"

# Seed script (scripts/seed-super-admin.mjs) — only used once to bootstrap the first super_admin
SEED_SUPER_ADMIN_NAME="Cazone GS&M Admin"
SEED_SUPER_ADMIN_USERNAME="superadmin"
SEED_SUPER_ADMIN_PASSWORD="change-me-before-seeding"

# Resend (https://resend.com) — powers the "Email" button on report screens (lib/email.js). Optional:
# without it, Email shows a clear "not configured" error instead of sending. REPORT_EMAIL_FROM must
# be a Resend-verified sending address/domain.
RESEND_API_KEY=""
REPORT_EMAIL_FROM="Cazone GS&M Reports <reports@yourdomain.com>"

# Vercel Blob (https://vercel.com/docs/storage/vercel-blob) — powers organization logo upload
# (app/api/admin/organization/logo/route.js). Create a Blob store on your Vercel project and link it
# to this project; Vercel then injects this automatically in production. For local dev, copy the
# token from the Vercel dashboard's Storage tab.
BLOB_READ_WRITE_TOKEN=""
