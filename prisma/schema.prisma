generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  super_admin
  owner
  manager
  // Fuel's 3-tier review chain (see lib/permissions.js, D5 of the fuel port): a supervisor submits
  // pump readings, a cashier separately records the payment collected, a manager approves both
  // before either counts. Additive to staff, not a replacement — other packs still just use staff.
  supervisor
  cashier
  auditor
  staff
  customer
}

enum SubscriptionStatus {
  trialing
  active
  past_due
  canceled
}

enum CatalogStatus {
  available
  coming_soon
  retired
}

// Platform-wide, not tenant-scoped (no organizationId — every organization sees the same catalog).
// This is what makes "add a service without a code deploy" real for the subscribe/availability
// layer: super_admin manages rows here instead of a hardcoded array. `key` is what Service.type
// already stores today, so it becomes a real FK with no data migration needed. Building the actual
// pack (schema + screens) for a new vertical is still separate engineering — this only controls
// whether an org can see/subscribe to it.
model ServiceCatalog {
  key         String        @id
  name        String
  description String?
  status      CatalogStatus @default(coming_soon)
  sortOrder   Int           @default(0)
  // Inert placeholder until per-service billing lands — same spirit as Organization's unused
  // Paystack fields. Org-level billing (Organization.monthlyPrice) is still the only thing enforced.
  basePriceMonthly Int      @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  services Service[]
}

// A single fixed row (id always "singleton") — Cazone's own brand, not any tenant's. Deliberately
// outside TENANT_SCOPED_MODELS (lib/prisma.js): it has no organizationId and must be readable
// pre-auth (login/signup favicon) as well as by super_admin (the only one who can change it).
model PlatformSettings {
  id           String   @id @default("singleton")
  logoUrl      String?
  logoUrlSmall String?
  updatedAt    DateTime @updatedAt
}

// The tenant. Everything else in the system belongs to exactly one Organization
// (except User, which is null-organization only for the super_admin platform operator).
model Organization {
  id    String @id @default(cuid())
  name  String
  slug  String @unique

  phone    String?
  email    String?
  currency String  @default("NGN")

  logoUrl       String?
  // Resized small variant (matches ecana_shop-app's pattern) — the sidebar/topbar avatar uses this
  // instead of fetching the full-size logo.
  logoUrlSmall  String?
  address       String?
  invoiceFooter String?
  bankName      String?
  accountNumber String?
  accountName   String?

  // Where one-time verification codes are sent for gated actions (credit-limit overrides, price
  // approvals — see lib/otp.js). Falls back to `email` above if unset. otpPhone is captured for a
  // future SMS channel — nothing sends to it yet, same "inert until wired up" precedent as the
  // Paystack fields below.
  otpEmail String?
  otpPhone String?

  // Billing — Paystack fields are inert placeholders until that phase lands, same as the precedent
  // set in ecana_shop-app's Organization model. subscriptionEndsAt is the current PAID period end,
  // distinct from trialEndsAt; both are set manually by super_admin for now.
  subscriptionStatus       SubscriptionStatus @default(trialing)
  trialEndsAt              DateTime?
  subscriptionEndsAt       DateTime?
  monthlyPrice             Int                @default(0)
  freeForever              Boolean            @default(false)
  paystackCustomerCode     String?
  paystackSubscriptionCode String?

  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  services  Service[]
  branches  Branch[]
  users     User[]
  auditLogs AuditLog[]

  customers       Customer[]
  customerAdjustments CustomerAdjustment[]
  payments        Payment[]
  products        Product[]
  priceRules      PriceRule[]
  priceHistory    PriceHistory[]
  notifications   Notification[]
  otpCodes        OtpCode[]
  priceGroups     PriceGroup[]
  orders          Order[]
  stockMoves      StockMove[]
  deliveries      Delivery[]
  reconciliations Reconciliation[]
  shifts          Shift[]
  cashDeposits    CashDeposit[]
  flags           Flag[]
  vehicles        Vehicle[]
  suppliers       Supplier[]
  counters        Counter[]

  // Fuel pack
  tanks                Tank[]
  dispensers           Dispenser[]
  meterReadings        MeterReading[]
  attendants           Attendant[]
  attendantAssignments AttendantAssignment[]
  posTerminals         PosTerminal[]
  posPayments          PosPayment[]
}

// A vertical the organization has switched on — "the organization can select how many of the
// services they want, eg shop, petrol station etc." `type` references ServiceCatalog.key (a DB row,
// not a Postgres enum), so adding a new vertical later is a catalog-row edit, not a migration.
model Service {
  id             String  @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  type     String
  catalog  ServiceCatalog @relation(fields: [type], references: [key])
  name     String?
  isActive Boolean @default(true)
  config   Json    @default("{}")

  createdAt DateTime @default(now())

  branches Branch[]
  products Product[]

  @@unique([organizationId, type])
  @@index([organizationId])
}

// A branch of a specific service — "branches will be handled the way petrol-station-app handles
// different stations under one admin." organizationId is denormalized from the parent Service so
// tenant-scoped queries never need to join through Service just to filter by tenant.
model Branch {
  id        String  @id @default(cuid())
  serviceId String
  service   Service @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  name     String
  code     String
  address  String?
  isActive Boolean @default(true)
  config   Json    @default("{}")

  createdAt DateTime @default(now())

  userAccess     UserBranchAccess[]
  customerAccess CustomerAccess[]

  orders          Order[]
  stockMoves      StockMove[]
  deliveries      Delivery[]
  reconciliations Reconciliation[]
  shifts          Shift[]
  cashDeposits    CashDeposit[]
  flags           Flag[]

  // Fuel pack
  tanks                Tank[]
  dispensers           Dispenser[]
  meterReadings        MeterReading[]
  attendants           Attendant[]
  attendantAssignments AttendantAssignment[]
  posTerminals         PosTerminal[]

  @@unique([organizationId, code])
  @@index([serviceId])
  @@index([organizationId])
}

// Login identities (email/username/phone) are GLOBALLY unique, so the login lookup can resolve a
// user to their tenant unambiguously before the tenant is known. organizationId is required for
// every role except super_admin (the platform operator, not a member of any organization).
model User {
  id             String        @id @default(cuid())
  organizationId String?
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  role Role @default(staff)

  name          String
  email         String? @unique
  username      String? @unique
  phone         String? @unique
  passwordHash  String
  actionPinHash String?

  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())

  branchAccess UserBranchAccess[]
  customer     Customer?

  @@index([organizationId])
}

// Many-to-many: scopes a manager/staff user to specific branches, possibly across different
// services. An owner (or a manager meant to run the whole org) simply has no rows here and is
// treated as whole-organization access by role check — see lib/permissions.js — rather than every
// branch needing a seeded row.
model UserBranchAccess {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  branchId String
  branch   Branch @relation(fields: [branchId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([userId, branchId])
}

// Append-only. actorUserId/actorName are denormalized (not a live FK to User) so a user's audit
// trail survives their own removal — "removing a user never deletes their history."
model AuditLog {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  actorUserId String
  actorName   String
  action      String
  entityType  String
  entityId    String
  before      Json?
  after       Json?

  createdAt DateTime @default(now())

  @@index([organizationId, createdAt])
}

// ---------------------------------------------------------------------------
// Core commerce/operations models — consolidated from petrol-station-app and
// ecana_shop-app per C:\Users\mail2\.claude\plans\federated-booping-sifakis.md.
// Each of these does double duty for every vertical pack rather than being
// reimplemented per pack. All money fields are Int (smallest currency unit,
// e.g. kobo) — never float — per the core-algorithms skill's first rule.
// ---------------------------------------------------------------------------

// The credit/account holder — a fleet card (fuel) and a materials account customer are the same
// entity. Belongs to the tenant, not a branch or a service, so one customer can transact across
// every branch of every service and receive one statement (platform-architecture skill).
model Customer {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  priceGroupId String?
  priceGroup   PriceGroup? @relation(fields: [priceGroupId], references: [id])

  // Portal login, staff-provisioned (see app/api/admin/customers/[id]/portal-access). One customer =
  // one login for v1 — no shared/multi-user accounts yet. Null until staff enables it.
  userId String? @unique
  user   User?   @relation(fields: [userId], references: [id])

  code         String?
  name         String
  phone        String?
  email        String?
  businessName String?

  creditLimit Int     @default(0)
  onHold      Boolean @default(false)
  // Cache only — Order/Payment rows are the source of truth (core-algorithms skill §3). Recompute
  // and alert on drift; never let this field be the only record of a balance.
  balance     Int     @default(0)

  isActive  Boolean  @default(true)
  createdBy String?
  createdAt DateTime @default(now())

  orders      Order[]
  adjustments CustomerAdjustment[]
  payments    Payment[]
  priceRules  PriceRule[]
  access      CustomerAccess[]

  @@unique([organizationId, code])
  @@index([organizationId])
}

// Which branch(es) a customer is registered/sellable at — branch-bound by default (one row, created
// alongside the customer at whichever branch registered them), business-bound transitively (a branch
// belongs to exactly one Service). Deliberately branch-grain, not just service-grain, so an org with
// two branches of the same business can still keep a customer scoped to just one of them. A second
// (or third) row is how staff explicitly share a customer's data/sellability across the org's
// different businesses — never automatic (see lib/branchAccess.js for who's allowed to add one).
model CustomerAccess {
  id         String   @id @default(cuid())
  customerId String
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  branchId   String
  branch     Branch   @relation(fields: [branchId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())

  @@unique([customerId, branchId])
  @@index([branchId])
}

// A manual balance move not tied to a specific Order — surcharge or refund.
model CustomerAdjustment {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  customerId String
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  type          String // surcharge | refund
  amount        Int
  reason        String?
  balanceBefore Int
  balanceAfter  Int
  createdBy     String?
  createdAt     DateTime @default(now())

  @@index([organizationId])
  @@index([customerId])
}

// Money received against a customer's account. `allocations` records which Order(s) it settles —
// oldest-due-first unless the payer specified otherwise (core-algorithms skill §3). An unallocated
// remainder is a credit on the account, never silently absorbed.
model Payment {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  customerId String
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  amount     Int
  method     String // cash | transfer | pos | cheque
  reference  String?
  recordedBy String?
  createdAt  DateTime @default(now())

  allocations PaymentAllocation[]

  @@index([organizationId])
  @@index([customerId])
}

// Join record, not arithmetic — reversing a payment reverses its allocations (core-algorithms
// skill §3). No organizationId of its own: always reached via an already-scoped Payment/Order.
model PaymentAllocation {
  id        String   @id @default(cuid())
  paymentId String
  payment   Payment  @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  orderId   String
  order     Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  amount    Int
  createdAt DateTime @default(now())

  @@index([paymentId])
  @@index([orderId])
}

// Generic catalog: one product concept spanning fuel/cement/stone dust/shop items, instead of a
// separate model per vertical. Whatever is genuinely product-specific (octane, bag size + grade,
// quarry + size) lives in `attributes`, not in new columns or new tables.
model Product {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  serviceId      String
  service        Service      @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  sku  String?
  name String
  unit String // litre | bag | tonne | each ...

  // Cement brands only (ecana_shop-app's CementBrand.abbreviation) — a short code (e.g. "DAN") used
  // in ATC numbers (DAN-001), so it's a real column rather than buried in `attributes`.
  abbreviation String?
  // Stonedust/aggregate products only (ecana_shop-app's StoneDustProduct.quarry) — which quarry
  // Supplier (type: 'quarry') this size/price applies to. Real FK, not a free-text attribute, since
  // it's joined/filtered on (the quarry detail page lists its own products by this).
  supplierId String?
  supplier   Supplier? @relation(fields: [supplierId], references: [id])

  // Regulated products (e.g. fuel PMS pricing) cannot be discounted — see PriceRule resolution order.
  priceRegulated   Boolean @default(false)
  conversionFactor Float?
  attributes       Json    @default("{}")
  isActive         Boolean @default(true)

  createdAt DateTime @default(now())

  priceRules      PriceRule[]
  priceHistory    PriceHistory[]
  orderLines      OrderLine[]
  stockMoves      StockMove[]
  deliveries      Delivery[]
  reconciliations Reconciliation[]
  tanks           Tank[]

  @@unique([organizationId, serviceId, sku])
  @@index([organizationId])
}

// Named customer segments (e.g. "contractors") a PriceRule can target instead of one customer.
model PriceGroup {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  name      String
  createdAt DateTime @default(now())

  customers  Customer[]
  priceRules PriceRule[]

  @@unique([organizationId, name])
  @@index([organizationId])
}

// Effective-dated price resolution (core-algorithms skill §1): regulated > customer+qty band >
// customer > price group+qty band > price group > list price. Changing a price never mutates a
// row — it closes one (sets validTo) and opens another, so a historic order always reprices
// identically. The winning rule's id is written onto the OrderLine, never recomputed later.
model PriceRule {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  productId    String
  product      Product     @relation(fields: [productId], references: [id], onDelete: Cascade)
  customerId   String?
  customer     Customer?   @relation(fields: [customerId], references: [id], onDelete: Cascade)
  priceGroupId String?
  priceGroup   PriceGroup? @relation(fields: [priceGroupId], references: [id], onDelete: Cascade)

  qtyBandMin Float?
  qtyBandMax Float?
  price      Int
  validFrom  DateTime  @default(now())
  validTo    DateTime?
  createdBy  String?
  createdAt  DateTime  @default(now())

  orderLines OrderLine[]

  @@index([organizationId])
  @@index([productId])
}

// One-time email codes gating the highest-stakes actions (credit-limit overrides, price approvals —
// see lib/otp.js) — replaces the earlier User.actionPinHash approach with a code sent fresh each
// time to the organization's OTP email, rather than a pre-set secret. Hashed like a password;
// single-use (consumedAt) and short-lived (expiresAt).
model OtpCode {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  userId    String
  purpose   String // credit_override | price_approval
  codeHash  String
  expiresAt DateTime
  consumedAt DateTime?

  createdAt DateTime @default(now())

  @@index([organizationId, userId, purpose])
}

// Best-effort in-app notification — see lib/notify.js. Never blocks the action that triggered it.
// `recipientUserId` targets one person (e.g. "your price proposal was approved"); `recipientRole`
// broadcasts to everyone with that role (v1 only ever targets 'owner' — matches the existing
// owner-view convention on the Anything Wrong page). Exactly one of the two is set.
model Notification {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  recipientUserId String?
  recipientRole   String?
  title           String
  message         String
  type            String // flag_raised | pending_order | deposit_submitted | deposit_decided | price_proposed | price_decided
  relatedType     String?
  relatedId       String?
  isRead          Boolean   @default(false)
  readAt          DateTime?

  createdAt DateTime @default(now())

  @@index([organizationId, recipientUserId, isRead])
  @@index([organizationId, recipientRole, isRead])
}

// Logs every price change, and gates non-owner ones behind approval — see lib/pricing.js setPrice().
// A brand-new product's first price always applies immediately regardless of role (nothing live to
// protect yet); only a change to an already-priced product needs owner sign-off from non-owners.
model PriceHistory {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  productId      String
  product        Product      @relation(fields: [productId], references: [id], onDelete: Cascade)

  oldPrice Int?
  newPrice Int
  reason   String?
  status   String  @default("approved") // pending | approved | rejected
  changedBy   String?
  approvedBy  String?
  approvedAt  DateTime?
  adminNote   String?

  createdAt DateTime @default(now())

  @@index([organizationId])
  @@index([productId, createdAt])
}

// The itemized transaction — an invoice (credit sale) and a cash sale are the same shape, only
// customerId/paymentMethod differ. orderNumber is minted from Counter, gapless, inside the same
// transaction that creates the row (core-algorithms skill §8). offlineId + the (organizationId,
// offlineId) unique index make replay from an offline device idempotent (skill §7).
model Order {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  branchId       String
  branch         Branch       @relation(fields: [branchId], references: [id], onDelete: Cascade)
  customerId     String?
  customer       Customer?    @relation(fields: [customerId], references: [id])

  orderNumber   String
  // active | void | pending (self-service portal orders sit pending until staff confirms them —
  // stock/credit only apply once active, see app/api/admin/materials/pending-orders).
  status        String   @default("active")
  subtotal      Int
  discount      Int      @default(0)
  grandTotal    Int
  paymentMethod String? // cash | credit | pos | transfer
  offlineId     String?
  createdBy     String?
  // Which side of the Materials business this sale came from — 'shop' (retail counter/self-service)
  // vs 'atc' (wholesale allocation, see lib/allocation.js) vs 'retail' (the separate General Retail
  // Store service). Null = unspecified/legacy. Lets a shared customer statement keep them
  // distinguishable without a separate ledger per channel.
  channel       String?
  createdAt     DateTime @default(now())

  lines       OrderLine[]
  allocations PaymentAllocation[]

  @@unique([organizationId, orderNumber])
  @@unique([organizationId, offlineId])
  @@index([organizationId])
  @@index([branchId])
  @@index([customerId])
}

// No organizationId of its own — always reached via an already-scoped Order. priceRuleId is the
// rule that resolved this line's price; the price is never recomputed from it later.
model OrderLine {
  id          String     @id @default(cuid())
  orderId     String
  order       Order      @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId   String
  product     Product    @relation(fields: [productId], references: [id], onDelete: Cascade)
  priceRuleId String?
  priceRule   PriceRule? @relation(fields: [priceRuleId], references: [id])
  // Set when this line is meant to draw from a specific supply allocation (lib/allocation.js)
  // rather than ordinary on-hand stock — remembered here so a pending order still draws from the
  // right batch once staff confirm it, not just at the moment it was placed.
  allocationId String?
  allocation   Delivery?  @relation(fields: [allocationId], references: [id])

  qty       Float
  unitPrice Int
  lineTotal Int

  @@index([orderId])
  @@index([productId])
}

// The stock ledger (core-algorithms skill §4) — there is no mutable quantity field anyone writes
// to directly. Any "current stock" figure is a cache computed from this table and recomputed
// nightly. Moves are append-only; a mistake is corrected by an opposing move, never an edit.
model StockMove {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  branchId       String
  branch         Branch       @relation(fields: [branchId], references: [id], onDelete: Cascade)
  productId      String
  product        Product      @relation(fields: [productId], references: [id], onDelete: Cascade)

  qty              Float // signed
  reason           String // purchase | sale | transfer | adjustment | stocktake | loss
  ref              String?
  conversionFactor Float?
  note             String?
  offlineId        String?
  userId           String?
  // Mirrors Order.channel for stock moves not tied to an Order (e.g. a purchase sourced directly for
  // the shop) — null = unspecified/legacy.
  channel          String?
  at               DateTime @default(now())

  @@unique([organizationId, offlineId])
  @@index([organizationId])
  @@index([branchId, productId])
}

// A delivery batch arriving — generalizes petrol-station-app's truck-offload StockMovement,
// ecana_shop-app's ATC (cement collection lifecycle) and QuarryPurchase (stone dust batch).
// `status` is nullable/free-text so a simple one-step delivery doesn't need to touch every stage
// of a multi-stage lifecycle like ATC's pending->assigned->loaded->arrived->closed.
model Delivery {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  branchId       String
  branch         Branch       @relation(fields: [branchId], references: [id], onDelete: Cascade)
  supplierId     String?
  supplier       Supplier?    @relation(fields: [supplierId], references: [id])
  vehicleId      String?
  vehicle        Vehicle?     @relation(fields: [vehicleId], references: [id])
  productId      String
  product        Product      @relation(fields: [productId], references: [id], onDelete: Cascade)

  quantity          Float
  costPerUnit       Int
  totalCost         Int
  status            String? // pending | assigned | loaded | arrived | received | closed
  // Set (to `quantity`) only when this delivery starts life as a not-yet-received allocation — a
  // batch already paid for but not yet counted as on-hand stock, drawn down directly by sales that
  // reference it (see lib/sale.js) rather than by first receiving it into the branch's stock ledger.
  // Null for the ordinary "received now" delivery, which behaves exactly as before. `status` moves
  // to 'closed' (not 'received') when this hits 0 via sales — 'received' stays reserved for "this
  // batch physically arrived and was logged as general stock," a distinct event.
  qtyRemaining      Float?
  assignedAt        DateTime?
  loadedAt          DateTime?
  arrivalDate       DateTime?
  receivedAt        DateTime?
  linkedStockMoveId String?
  createdBy         String?
  createdAt         DateTime @default(now())

  // Materials/cement-only: an ATC's own tracking number (paired with the brand's abbreviation for
  // display, e.g. "DAN-001" — ecana_shop-app's ATC.atcNumber, ported). `notes` is the free-text field
  // that ride-along ATC form has too; generic enough other allocation types could use it later.
  atcNumber String?
  notes     String?

  // Fuel-only, optional: a tanker offload verified against a physical tank dip rather than trusted
  // on the waybill alone. When set, `quantity` above IS `actualOffloaded` (closingDip - openingDip)
  // so every existing consumer of Delivery.quantity/totalCost keeps working unchanged — declaredLoad
  // and offloadVariance are just the extra provenance the dip check adds (petrol-station-app's
  // declaredLoad/actualOffloaded/offloadVariance, ported field-for-field).
  tankId          String?
  tank            Tank?   @relation(fields: [tankId], references: [id])
  declaredLoad    Float?
  openingDip      Float?
  closingDip      Float?
  offloadVariance Float?

  orderLines OrderLine[]

  @@index([organizationId])
  @@index([branchId])
}

// The shared bulk-reconciliation abstraction (core-algorithms skill §5) — a tank dip and a
// stockpile survey are the same problem underneath: book = opening + receipts - sales, variance =
// measured - book. Each product declares its own tolerance; within it, this record IS the
// adjustment; outside it, status stays "exception" until a manager acknowledges with a reason.
model Reconciliation {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  branchId       String
  branch         Branch       @relation(fields: [branchId], references: [id], onDelete: Cascade)
  productId      String
  product        Product      @relation(fields: [productId], references: [id], onDelete: Cascade)

  periodStart DateTime
  periodEnd   DateTime
  opening     Float
  receipts    Float
  sales       Float
  book        Float
  measured    Float
  variance    Float
  variancePct Float
  tolerance   Float

  status             String  @default("pending") // within_tolerance | exception | acknowledged
  acknowledgedBy     String?
  acknowledgedReason String?

  createdAt DateTime @default(now())

  @@index([organizationId])
  @@index([branchId, productId])
}

// A cashier/attendant's session at a till or pump (core-algorithms skill §6) — not fuel-specific;
// a shop till reconciliation is the same shape as a forecourt cash-up. Reopening a closed shift is
// owner-only and always audited (reopenedBy/reopenedAt), never a silent edit.
model Shift {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  branchId       String
  branch         Branch       @relation(fields: [branchId], references: [id], onDelete: Cascade)

  openedBy     String
  openingFloat Int     @default(0)
  countedCash  Int?
  countedFloat Int?
  expectedCash Int?
  difference   Int?
  status       String  @default("open") // open | closed
  note         String?

  openedAt   DateTime  @default(now())
  closedAt   DateTime?
  reopenedBy String?
  reopenedAt DateTime?

  // Multi-shift-per-day labeling (petrol-station-app's shiftKey/shiftOrder/totalShiftsPlanned) — all
  // optional. A branch that just runs one shift at a time leaves these unset and nothing changes;
  // one that plans e.g. 3 shifts/day sets totalShiftsPlanned once at the first Begin Shift of the
  // day and shiftOrder increments as each one opens.
  shiftLabel         String?
  shiftOrder         Int?
  totalShiftsPlanned Int?

  cashDeposits CashDeposit[]

  // Fuel pack
  meterReadings        MeterReading[]
  attendantAssignments AttendantAssignment[]

  @@index([organizationId])
  @@index([branchId])
}

// Nothing fuel-specific about "cashier deposits cash to the bank, admin approves" — used by every
// vertical the same way.
model CashDeposit {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  branchId       String
  branch         Branch       @relation(fields: [branchId], references: [id], onDelete: Cascade)
  shiftId        String?
  shift          Shift?       @relation(fields: [shiftId], references: [id])

  amount        Int
  bankName      String?
  accountNumber String?
  initiatedBy   String
  status        String  @default("pending") // pending | approved | rejected
  approvedBy    String?
  note          String?
  createdAt     DateTime @default(now())

  @@index([organizationId])
  @@index([branchId])
}

// The "anything wrong" exceptions queue (platform-ui skill §7) — consolidates petrol-station-app's
// Flag + AuditComment + AuditorComment (three overlapping models) into one. targetType/targetId
// point at whatever record (a Reconciliation, a Shift, an Order...) the flag concerns.
model Flag {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  branchId       String?
  branch         Branch?      @relation(fields: [branchId], references: [id])

  targetType     String
  targetId       String?
  severity       String  @default("info") // info | concern | issue
  classification String? // observation | concern | issue | recommendation
  reason         String
  status         String  @default("open") // open | acknowledged | resolved
  raisedBy       String
  resolvedBy     String?
  createdAt      DateTime @default(now())

  @@index([organizationId])
  @@index([branchId])
}

// A delivery vehicle — was `Truck` in both source apps, identically shaped. Generic enough for a
// fuel tanker or a cement/stone dust truck.
model Vehicle {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  plateNumber String
  driverName  String?
  driverPhone String?
  ownership   String? // own | supplier
  capacity    Float?
  type        String? // tanker | truck ...
  isActive    Boolean @default(true)
  createdAt   DateTime @default(now())

  deliveries Delivery[]

  @@unique([organizationId, plateNumber])
  @@index([organizationId])
}

// A delivery source — a fuel depot is the same shape as a cement depot or a quarry.
model Supplier {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  name     String
  type     String? // depot | quarry | fuel_depot ...
  phone    String?
  address  String?
  isActive Boolean @default(true)
  createdAt DateTime @default(now())

  deliveries Delivery[]
  products   Product[]

  @@index([organizationId])
}

// Atomic per-org, per-document-type sequence generator (core-algorithms skill §8) — gapless
// numbering for orders/invoices/receipts. Allocate from this inside the same transaction that
// creates the record, never from a count or a timestamp.
model Counter {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  key String
  seq Int    @default(0)

  @@unique([organizationId, key])
}

// ---------------------------------------------------------------------------
// Fuel pack — genuinely vertical-specific, per platform-architecture skill's seven-slot rule
// ("settings" and "captureMethods"). Everything else fuel needs (products, orders, the stock
// ledger, reconciliation, shifts, cash deposits) already lives in core above. Notably absent: a
// TankStockEntry model — a tank dip is just fuel's `measured` input into the core
// Reconciliation.reconcile(), not a separate table (core-algorithms skill §5). PumpReassignment
// from petrol-station-app isn't ported either — a mid-shift swap is a new AttendantAssignment row
// (endedAt closes the old one) plus an AuditLog entry, not a dedicated model.
// ---------------------------------------------------------------------------

// Physical tank at a branch, holding one product. "settings" pack contribution.
model Tank {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  branchId       String
  branch         Branch       @relation(fields: [branchId], references: [id], onDelete: Cascade)
  productId      String
  product        Product      @relation(fields: [productId], references: [id])

  label     String
  capacity  Float
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())

  dispensers Dispenser[]
  deliveries Delivery[]

  @@unique([branchId, label])
  @@index([organizationId])
  @@index([branchId])
}

// A pump. "settings" pack contribution.
model Dispenser {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  branchId       String
  branch         Branch       @relation(fields: [branchId], references: [id], onDelete: Cascade)
  tankId         String?
  tank           Tank?        @relation(fields: [tankId], references: [id])

  label     String
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())

  meterReadings        MeterReading[]
  attendantAssignments AttendantAssignment[]

  @@unique([branchId, label])
  @@index([organizationId])
  @@index([branchId])
}

// The fuel-specific "captureMethod": a pump's meter opening/closing for a shift. Fuel's tighter
// three-way check per core-algorithms skill §5/§6 — cash, sales records and pump meter movement
// must agree — is computed from this plus the shift's Order/StockMove rows, not stored here.
model MeterReading {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  branchId       String
  branch         Branch       @relation(fields: [branchId], references: [id], onDelete: Cascade)
  dispenserId    String
  dispenser      Dispenser    @relation(fields: [dispenserId], references: [id], onDelete: Cascade)
  shiftId        String
  shift          Shift        @relation(fields: [shiftId], references: [id], onDelete: Cascade)
  // Set when this reading is closed — the Order it produced, so shift-end cash-up can sum exactly
  // this shift's sales instead of approximating by timestamp.
  orderId        String?      @unique

  opening Float
  closing Float?
  rtt     Float @default(0) // return-to-tank
  // Litres already sold to named credit customers mid-shift (see fuel credit-fill action) — the
  // close-time aggregate cash sale is (closing - opening - rtt - creditLitres), so a credit fill
  // is never also counted as an anonymous cash sale.
  creditLitres Float @default(0)

  discrepancyFlag Boolean  @default(false)
  // Manager's note when querying a submission (reviewStatus: 'queried') — reused for that purpose
  // now; was unused before D5.
  discrepancyNote String?
  // pending -> approved | queried, the 3-tier review chain (D5): a supervisor submits (closing/rtt
  // recorded, litres/expectedAmount computed), a cashier separately records the payment, and only a
  // manager's approval creates the Order/StockMove — see .../approve/route.js. 'queried' sends it
  // back for correction; recordedBy/paymentRecordedBy can resubmit while queried.
  reviewStatus    String   @default("pending")
  reviewedBy      String?
  reviewedAt      DateTime?
  recordedBy      String?
  createdAt       DateTime @default(now())

  // Computed at submit time (litres = closing - opening - rtt - creditLitres; expectedAmount =
  // litres * the price in effect then) so a manager reviewing later compares against what was true
  // at submission, not whatever the price happens to be now.
  litres         Float?
  expectedAmount Int?

  // Cashier's separate entry — cash plus itemized POS lines (posPayments below).
  cashCollected     Int?
  paymentRecordedBy String?
  paymentRecordedAt DateTime?

  posPayments PosPayment[]

  @@unique([shiftId, dispenserId])
  @@index([organizationId])
  @@index([branchId])
}

// A branch's registered card terminals — a payment can split its POS portion across several
// (PosPayment), matching petrol-station-app's POSTerminal.
model PosTerminal {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  branchId       String
  branch         Branch       @relation(fields: [branchId], references: [id], onDelete: Cascade)

  label      String
  terminalId String? // provider's own ID for the terminal, if they have one
  provider   String? // e.g. paystack | interswitch | other
  isActive   Boolean @default(true)
  createdAt  DateTime @default(now())

  posPayments PosPayment[]

  @@index([organizationId])
  @@index([branchId])
}

// One line of a cashier's POS collection for a pump — a payment can span multiple terminals/banks.
model PosPayment {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  meterReadingId String
  meterReading   MeterReading @relation(fields: [meterReadingId], references: [id], onDelete: Cascade)
  terminalId     String
  terminal       PosTerminal  @relation(fields: [terminalId], references: [id])

  amount    Int
  createdAt DateTime @default(now())

  @@index([organizationId])
  @@index([meterReadingId])
}

// Non-login HR record — most pump attendants don't get a User account, just a staff record for
// assignment and performance tracking. Deliberately distinct from User, same as
// petrol-station-app kept it.
model Attendant {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  branchId       String
  branch         Branch       @relation(fields: [branchId], references: [id], onDelete: Cascade)

  staffNumber    String
  name           String
  phone          String?
  position       String?
  employmentType String?
  // HR fields matching petrol-station-app's Attendant.js — optional, filled in as an org actually
  // wants the fuller profile.
  dateOfBirth    DateTime?
  gender         String?
  photoUrl       String?
  employmentDate DateTime?
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())

  notes       AttendantNote[]
  assignments AttendantAssignment[]

  @@unique([branchId, staffNumber])
  @@index([organizationId])
}

// No organizationId of its own — always reached via an already-scoped Attendant.
model AttendantNote {
  id          String    @id @default(cuid())
  attendantId String
  attendant   Attendant @relation(fields: [attendantId], references: [id], onDelete: Cascade)

  note      String
  addedBy   String?
  createdAt DateTime @default(now())

  @@index([attendantId])
}

// Links an attendant to a pump for a shift. A mid-shift swap creates a new row and sets `endedAt`
// on the old one, rather than mutating or deleting — the AuditLog captures who changed it and why.
model AttendantAssignment {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  branchId       String
  branch         Branch       @relation(fields: [branchId], references: [id], onDelete: Cascade)
  dispenserId    String
  dispenser      Dispenser    @relation(fields: [dispenserId], references: [id], onDelete: Cascade)
  shiftId        String
  shift          Shift        @relation(fields: [shiftId], references: [id], onDelete: Cascade)
  attendantId    String
  attendant      Attendant    @relation(fields: [attendantId], references: [id], onDelete: Cascade)

  assignedBy String?
  assignedAt DateTime  @default(now())
  endedAt    DateTime?
  // Set on the row that got ended by a mid-shift reassignment (not a normal end-of-shift close) —
  // a required, permanent record of why, matching petrol-station-app's PumpReassignment log.
  endedBy         String?
  reassignReason  String?

  @@index([organizationId])
  @@index([shiftId, dispenserId])
}
